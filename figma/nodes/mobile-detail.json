      "x": 24,
      "y": 761,
      "w": 33,
      "h": 14
    },
    {
      "id": "decrease",
      "selector": "role=button[name=\"Diminuir quantidade\"]",
      "measure": "box",
      "x": 69,
      "y": 752,
      "w": 20,
      "h": 30
    },
    {
      "id": "price",
      "selector": "data-testid=mobile-price",
      "measure": "ink",
      "x": 295,
      "y": 760,
      "w": 94,
      "h": 16,
      "font": {
        "size": 20,
        "weight": 700,
        "lineHeight": 28
      }
    },
    {
      "id": "buy-button",
      "selector": "role=button[name=\"Comprar NFT\"]",
